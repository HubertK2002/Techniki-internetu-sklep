{% if app.user %}
	{% set heart_variant = heart_variant|default('default') %}
	{% set default_heart_class = 'p-0 border-0 bg-transparent d-inline-flex align-items-center justify-content-center' %}
	<form
		method="post"
		action="{{ path(in_wishlist ? 'wishlist_remove' : 'wishlist_add', { id: product.id }) }}"
		class="m-0 js-wishlist-form"
		data-wishlist-action="{{ in_wishlist ? 'remove' : 'add' }}"
		data-wishlist-role="toggle"
		data-product-id="{{ product.id }}"
	>
		<input type="hidden" name="_token" value="{{ csrf_token((in_wishlist ? 'wishlist_remove_' : 'wishlist_add_') ~ product.id) }}">
		<button type="submit" class="{{ heart_variant == 'product' ? 'wishlist-heart-btn-product' : default_heart_class }}" {% if heart_variant != 'product' %}style="line-height: 0;"{% endif %}>
			{% if in_wishlist %}
				<img src="{{ asset('images/heart_full.svg') }}" alt="Artex" height="20">
			{% else %}
				<img src="{{ asset('images/heart.svg') }}" alt="Artex" height="20">
			{% endif %}
		</button>
	</form>
{% else %}
	<a href="{{ path('app_login') }}" class="p-0 border-0 bg-transparent d-inline-flex align-items-center justify-content-center" style="line-height: 0;" aria-label="Dodaj do ulubionych">
		<img src="{{ asset('images/heart.svg') }}" alt="Artex" height="20">
	</a>
{% endif %}
