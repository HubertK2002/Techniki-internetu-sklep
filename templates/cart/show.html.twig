{% extends 'base.html.twig' %}

{% block title %}Koszyk{% endblock %}
{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/cart.css') }}">
{% endblock %}

{% block body %}
<nav class="col-12 navbar navbar-expand-lg navbar-light bg-light p-0">
	{{ render(path('category_index')) }}
</nav>

{% for lines in app.flashes('stock_errors') %}
	<div class="alert alert-danger">
		<div class="fw-semibold mb-2">Brak na stanie:</div>
		<ul class="mb-0">
			{% for line in lines %}
				<li>{{ line }}</li>
			{% endfor %}
		</ul>
	</div>
{% endfor %}

{% for msg in app.flashes('error') %}
	<div class="alert alert-danger">{{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('success') %}
	<div class="alert alert-success">{{ msg }}</div>
{% endfor %}

<div data-controller="cart-qty-guard">
	<div class="container py-4 body-text">
		{% if cart is null or cart.Items|length == 0 %}
			<h1 class="mb-2 h-title">Twój koszyk</h1>
			<div class="cart-title-divider mb-4"></div>
			<div class="alert alert-secondary">Koszyk jest pusty.</div>
		{% else %}
			<div class="row g-0 align-items-start">
				<div class="col-12 col-xl">
					<h1 class="mb-2 h-title">Twój koszyk</h1>
					<div class="cart-title-divider mb-4"></div>

					{% set total = 0 %}
					<div class="cart-list">
						{% for item in cart.Items %}
							{% set p = item.Product %}
							{% set line = (p ? p.EffectivePrice : 0) * item.Quantity %}
							{% set total = total + line %}
							<div class="cart-item py-3" data-cart-item data-unit-price="{{ (p ? p.EffectivePrice : 0)|number_format(2, '.', '') }}">
								<div class="cart-item-content d-flex gap-3">
									<div class="d-flex align-items-center gap-3">
										<label class="cart-select-label m-0">
											<input type="checkbox" class="cart-select-checkbox" data-cart-select data-product-id="{{ p.id }}" checked>
											<span class="cart-select-checkmark">✓</span>
										</label>
										<div class="cart-thumb">
											{% if p.Image %}
												<img src="{{ asset('products/' ~ p.Image) }}" alt="{{ p.Name }}" class="img-fluid rounded">
											{% else %}
												<div class="cart-thumb-empty">Brak zdjęcia</div>
											{% endif %}
										</div>
									</div>

									<div class="flex-grow-1 d-flex flex-column justify-content-between">
										<div class="d-flex justify-content-between align-items-start gap-3">
											<div class="fw-semibold">{{ p.Name }}</div>
											<div class="d-flex align-items-start gap-3">
												<form method="post" action="{{ path('cart_remove', { id: p.id }) }}" class="m-0">
													<button type="submit" class="icon-btn" aria-label="Usuń z koszyka">
														<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<polyline points="3 6 5 6 21 6"></polyline>
															<path d="M19 6l-1 14H6L5 6"></path>
															<path d="M10 11v6"></path>
															<path d="M14 11v6"></path>
															<path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
														</svg>
													</button>
												</form>

												{% set in_wishlist = app.user and app.user.wishlist and app.user.wishlist.hasProduct(p) %}
												<div class="js-wishlist-toggle-container d-inline-flex align-items-center justify-content-center" style="line-height: 0;">
													{{ include('wishlist/_toggle_button.html.twig', { product: p, in_wishlist: in_wishlist }) }}
												</div>
											</div>
										</div>

										<div class="d-flex justify-content-end align-items-end mt-3">
											<div class="d-flex align-items-end gap-4">
												<div class="text-end">
													<div class="text-muted small">Cena</div>
													{% if p and p.hasPromotion %}
														<div class="small text-muted text-decoration-line-through">{{ p.Price|number_format(2, ',', ' ') }} zł</div>
														<div class="fw-semibold text-danger">{{ p.EffectivePrice|number_format(2, ',', ' ') }} zł</div>
													{% else %}
														<div class="fw-semibold">{{ p.Price|number_format(2, ',', ' ') }} zł</div>
													{% endif %}
												</div>
												<form
													method="post"
													action="{{ path('cart_set_qty', { id: p.id }) }}"
													data-action="submit->cart-qty-guard#saveRow"
													data-turbo="false"
													class="d-flex align-items-center gap-2 m-0"
												>
													<button type="button" class="cart-qty-step-btn" data-cart-qty-minus>-</button>
													<div class="cart-qty-ring">
														<input
															type="number"
															name="qty"
															min="1"
															value="{{ item.Quantity }}"
															class="cart-qty-input"
															data-cart-qty-guard-target="qty"
															data-initial-qty="{{ item.Quantity }}"
															data-product-name="{{ p.Name }}"
															data-set-url="{{ path('cart_set_qty', { id: p.id }) }}"
															data-cart-qty-input
														>
													</div>
													<button type="button" class="cart-qty-step-btn" data-cart-qty-plus>+</button>
													<button class="d-none" type="submit">Zapisz</button>
												</form>
												<div class="text-end">
													<div class="text-muted small">Razem</div>
													<div class="fw-semibold" data-cart-line-total>{{ line|number_format(2, ',', ' ') }} zł</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						{% endfor %}
					</div>

				</div>

				<div class="col-12 col-xl-auto d-flex justify-content-start">
					<div class="cart-side-panel d-flex flex-column">
						<div class="cart-side-summary">
							<div class="text-muted small">Razem</div>
							<div class="fs-5 fw-bold"><span id="cart-grand-total">{{ total|number_format(2, ',', ' ') }} zł</span></div>
							<form
								method="post"
								action="{{ path('order_create_from_cart') }}"
								class="mt-3"
								data-cart-qty-guard-target="checkoutForm"
								data-action="submit->cart-qty-guard#checkoutSubmit"
								data-turbo="false"
								id="cart-checkout-form"
							>
								<input type="hidden" name="use_selected_only" value="1">
								<div id="selected-items-inputs"></div>
								<button class="btn cart-checkout-btn w-100" type="submit">Złóż zamówienie</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		{% endif %}
	</div>

	{# Modal #}
	<div class="modal fade" tabindex="-1" data-cart-qty-guard-target="modal">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Niezapisane zmiany w koszyku</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
				</div>

				<div class="modal-body">
					<p class="mb-2">Zmieniłeś ilości produktów:</p>
					<ul class="mb-0" data-cart-qty-guard-target="list"></ul>
				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
						Anuluj
					</button>

					<button type="button" class="btn btn-outline-danger"
						data-cart-qty-guard-target="ignoreButton"
						data-action="click->cart-qty-guard#ignoreAndContinue">
						Zignoruj zmiany i kontynuuj
					</button>

					<button type="button" class="btn btn-primary"
						data-cart-qty-guard-target="saveButton"
						data-action="click->cart-qty-guard#saveAndContinue">
						Zapisz zmiany i kontynuuj
					</button>
				</div>
			</div>
		</div>
	</div>

</div>

{% endblock %}
